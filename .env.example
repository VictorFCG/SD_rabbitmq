# Copie para .env (na raiz do projeto). Todas as variaveis sao opcionais.
# Formato: CHAVE=valor (um "# comentario" no fim da linha e ignorado).

# --- E-mail (MS Promocoes) ----------------------------------------------------
# Sem RESEND_API_KEY os e-mails vao para o Mailpit (http://localhost:8025).
# Sem dominio verificado, o Resend (https://resend.com) so entrega no e-mail do
# dono da conta; o plano gratuito envia ate 100 e-mails por dia.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Loja SD <onboarding@resend.dev>
# Provedor: resend | mailpit | console (vazio = automatico)
# EMAIL_PROVIDER=resend
# MAILPIT_URL=http://127.0.0.1:8025
# Segundos entre as promocoes geradas
# PROMOCAO_INTERVALO=30

# --- MS Entrega ---------------------------------------------------------------
# Segundos simulando a emissao da nota fiscal e o despacho
# ENTREGA_DELAY=2

# --- RabbitMQ -----------------------------------------------------------------
# RABBITMQ_HOST=127.0.0.1

# --- Portas/URLs dos servicos HTTP ---------------------------------------------
# (run.sh e run.ps1 assumem as portas padrao)
# HTTP_HOST=127.0.0.1
# PRINCIPAL_PORT=8001
# ESTOQUE_PORT=8002
# PAGAMENTO_PORT=8003
# PROMOCOES_PORT=8004
# ESTOQUE_URL=http://127.0.0.1:8002
# PROMOCOES_URL=http://127.0.0.1:8004
# FRONTEND_URL=http://localhost:5173
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mock de Pagamento (sistema externo) ---------------------------------------
# MOCK_PORT=8005
# MOCK_PUBLIC_URL=http://127.0.0.1:8005
# MOCK_PAGAMENTO_URL=http://127.0.0.1:8005
# PAGAMENTO_WEBHOOK_URL=http://127.0.0.1:8003/webhooks/pagamento
# WEBHOOK_SECRET=trab2-webhook-secret
